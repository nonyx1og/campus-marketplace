# ==============================================================================
# Campus Marketplace - Biến môi trường ứng dụng (Environment Variables)
# ==============================================================================
# QUY TẮC BẢO MẬT:
# - Các biến tiền tố EXPO_PUBLIC_* được Expo đóng gói trực tiếp vào file JavaScript
#   của ứng dụng di động nên bất kỳ ai cũng có thể đọc được.
# - TUYỆT ĐỐI KHÔNG lưu Secret Key, Service Role Key hoặc Database Password vào đây!
# ==============================================================================

# URL API Remote Backend (Ví dụ: Server Node.js / FastAPI / Supabase REST API)
EXPO_PUBLIC_API_URL=https://api.campusmarketplace.edu.vn/api/v1

# Thời gian chờ tối đa cho mỗi request mạng (milliseconds)
EXPO_PUBLIC_API_TIMEOUT=15000

# Bật/Tắt chế độ dữ liệu mẫu dự phòng khi server trường offline (true/false)
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true
