{
  "name": "campus-marketplace",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "audit:theme": "node scripts/audit-domain-theme.js",
    "test:auth": "node scripts/test-auth-session.js",
    "test:catalogue": "node scripts/test-catalogue-flow.js",
    "test:filter": "node scripts/test-search-filter.js",
    "test:listing": "node scripts/test-listing-flow.js",
    "test:favorites": "node scripts/test-favorites-flow.js",
    "test:cart": "node scripts/test-cart-flow.js",
    "test": "npm run test:auth && npm run test:catalogue && npm run test:filter && npm run test:listing && npm run test:favorites && npm run test:cart",
    "check:all": "npm run typecheck && npm run audit:theme && npm run test",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.67.1",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
